# Copier en `.env` (jamais commité). Valeurs adaptées au `docker compose` local.

# Serveur commun
PORT=3000
HOST=0.0.0.0

# Postgres (docker compose)
POSTGRES_USER=live
POSTGRES_PASSWORD=live
POSTGRES_DB=live
DATABASE_URL=postgres://live:live@localhost:5432/live

# LiveKit (mode dev du docker compose)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
